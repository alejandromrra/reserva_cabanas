{
  "name": "cabanas-del-sendero",
  "version": "1.0.0",
  "private": true,
  "description": "Reservas de un complejo serrano de seis cabañas. React + Tailwind, datos en localStorage.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host --port ${PORT:-3100}",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port ${PORT:-4173}",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
